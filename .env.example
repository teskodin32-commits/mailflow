GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-railway-app.railway.app/api/accounts/callback
PORT=3000

# Required for dashboard PIN (do not use the old default 1234)
APP_PIN=REPLACE_WITH_YOUR_4_DIGIT_PIN
# Required for Gmail App Password encryption (64 hex digits / 32 random bytes)
SMTP_CREDENTIALS_KEY=generate_using_node_crypto_randomBytes_32_hex
